# Copy to .env and export (or use your process manager). Nothing here is read automatically.
DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:password@localhost:5432/blueprint
GROQ_API_KEY=your-groq-api-key
# Any Groq chat model that supports JSON mode; see console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
